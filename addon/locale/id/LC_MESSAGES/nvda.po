msgid ""
msgstr ""
"Project-Id-Version: nvdaMcp 1.0.0\n"
"Language: id\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Translators: The name of the category of this add-on's commands in the Input Gestures dialog.
#. Translators: The title of this add-on's panel in NVDA's settings dialog.
msgid "NVDA MCP"
msgstr "NVDA MCP"

#. Translators: A checkbox in the NVDA MCP settings panel.
msgid "&Let MCP clients, such as AI assistants, connect to NVDA"
msgstr "&Izinkan klien MCP, seperti asisten AI, terhubung ke NVDA"

#. Translators: A checkbox in the NVDA MCP settings panel.
msgid "Allow MCP clients to &press keys"
msgstr "Izinkan klien MCP &menekan tombol"

#. Translators: A checkbox in the NVDA MCP settings panel.
msgid "&Ask before the first key press after NVDA starts"
msgstr "&Tanyakan sebelum penekanan tombol pertama setelah NVDA dimulai"

#. Translators: A spin control in the NVDA MCP settings panel.
msgid "Number of spoken &messages to remember:"
msgstr "Jumlah &ucapan yang diingat:"

#. Translators: Reported when an NVDA MCP command is used but the add-on is not running.
msgid "NVDA MCP is off. Turn it on in NVDA Settings, NVDA MCP category."
msgstr "NVDA MCP mati. Nyalakan di Pengaturan NVDA, kategori NVDA MCP."

#. Translators: Describes a command in the Input Gestures dialog.
msgid "Reports whether NVDA MCP is running and whether it may press keys"
msgstr "Melaporkan apakah NVDA MCP berjalan dan apakah boleh menekan tombol"

#. Translators: Reported by the status command when key presses are allowed.
msgid "may press keys"
msgstr "boleh menekan tombol"

#. Translators: Reported by the status command when key presses are not allowed.
msgid "read only"
msgstr "hanya baca"

#. Translators: Reported by the status command. {port} is a network port number, {control} describes permissions.
msgid "NVDA MCP running on port {port}, {control}"
msgstr "NVDA MCP berjalan di port {port}, {control}"

#. Translators: Describes a command in the Input Gestures dialog.
msgid "Stops MCP clients from pressing keys until you approve again"
msgstr "Menghentikan klien MCP menekan tombol sampai Anda menyetujui lagi"

#. Translators: Reported after the user revokes permission to press keys.
msgid "Key press permission revoked"
msgstr "Izin menekan tombol dicabut"

#. Translators: Says who wants to press keys, in the dialog asking to allow it.
#. {client} is the name the program gives itself, such as Claude Code; NVDA cannot verify it.
msgid "An MCP client calling itself {client}"
msgstr "Klien MCP yang menyebut dirinya {client}"

#. Translators: Says who wants to press keys, when the program gave no name.
msgid "An MCP client, such as an AI assistant,"
msgstr "Sebuah klien MCP, misalnya asisten AI,"

#. Translators: Asks the user whether an AI assistant may press keys through NVDA.
#. {who} is who is asking, such as "An MCP client calling itself Claude Code".
msgid ""
"{who} wants to press keys on this computer through NVDA, for example to "
"move through an application with Tab. Keys go to whichever window is "
"active.\n"
"\n"
"Allow this until NVDA restarts?"
msgstr ""
"{who} ingin menekan tombol di komputer ini melalui NVDA, misalnya untuk "
"berpindah di dalam aplikasi dengan Tab. Tombol dikirim ke jendela mana pun "
"yang sedang aktif.\n"
"\n"
"Izinkan sampai NVDA dimulai ulang?"

#. Translators: Title of the dialog asking to allow an MCP client to press keys.
#. {client} is the name the program gives itself, such as Claude Code.
msgid "NVDA MCP: allow {client} to press keys?"
msgstr "NVDA MCP: izinkan {client} menekan tombol?"

#. Translators: Title of the dialog asking to allow an MCP client to press keys, when it gave no name.
msgid "NVDA MCP: allow an MCP client to press keys?"
msgstr "NVDA MCP: izinkan klien MCP menekan tombol?"

#. Translators: Reported when the user did not answer in time whether an MCP client may press keys.
msgid "NVDA MCP stopped waiting for your answer, so no keys were pressed."
msgstr "NVDA MCP berhenti menunggu jawaban Anda, jadi tidak ada tombol yang ditekan."

#. Translators: A text field in the NVDA MCP settings panel.
msgid "Only let MCP clients control these &applications (comma separated, empty for all):"
msgstr "Hanya izinkan klien MCP mengontrol &aplikasi ini (pisahkan dengan koma, kosongkan untuk semua):"

#. Translators: A checkbox in the NVDA MCP settings panel.
msgid "&Keep a log of every action MCP clients take"
msgstr "&Catat setiap aksi yang dilakukan klien MCP"

#. Translators: Describes a command in the Input Gestures dialog.
msgid "Opens the log of actions MCP clients have taken"
msgstr "Membuka catatan aksi yang telah dilakukan klien MCP"

#. Translators: Reported when the user opens the action log before any action was recorded.
msgid "No actions have been logged yet"
msgstr "Belum ada aksi yang dicatat"

#. Translators: An MCP client in the NVDA MCP settings panel's list of clients to set up.
msgid "Claude Code"
msgstr "Claude Code"

#. Translators: An MCP client in the NVDA MCP settings panel's list of clients to set up.
msgid "Codex CLI"
msgstr "Codex CLI"

#. Translators: In the NVDA MCP settings panel's list of clients to set up:
#. other clients, configured by pasting JSON settings into their settings file.
msgid "Other clients (JSON settings)"
msgstr "Klien lain (pengaturan JSON)"

#. Translators: An MCP client in the NVDA MCP settings panel's list of clients to set up.
msgid "Claude Desktop"
msgstr "Claude Desktop"

#. Translators: An MCP client in the NVDA MCP settings panel's list of clients to set up.
#. Antigravity is Google's AI coding application.
msgid "Antigravity"
msgstr "Antigravity"

#. Translators: An MCP client in the NVDA MCP settings panel's list of clients to set up.
msgid "Cursor"
msgstr "Cursor"

#. Translators: A list in the NVDA MCP settings panel, choosing the program to set up.
msgid "Set up this MCP &client:"
msgstr "Siapkan &klien MCP ini:"

#. Translators: A button in the NVDA MCP settings panel.
msgid "C&opy setup command"
msgstr "Sal&in perintah penyiapan"

#. Translators: Reported after copying an MCP client's JSON settings in the NVDA MCP settings panel.
msgid "Settings copied. Paste them into the client's MCP settings file."
msgstr "Pengaturan disalin. Tempelkan ke file pengaturan MCP milik klien tersebut."

#. Translators: A button in the NVDA MCP settings panel that opens the author's PayPal page in a web browser.
msgid "&Donate to support NVDA MCP (opens PayPal)"
msgstr "&Donasi untuk mendukung NVDA MCP (membuka PayPal)"

#. Translators: Reported after copying a setup command in the NVDA MCP settings panel.
msgid "Setup command copied. Paste it into a command prompt and press Enter."
msgstr "Perintah penyiapan disalin. Tempelkan ke command prompt lalu tekan Enter."

#. Translators: A checkbox in the NVDA MCP settings panel. Remote debugging is a setting of Chrome and Brave.
msgid "Let MCP clients read the &HTML of web pages through the browser's remote debugging"
msgstr "Izinkan klien MCP membaca &HTML halaman web melalui remote debugging browser"

#. Translators: A checkbox in the NVDA MCP settings panel. The pictures are sent to the AI assistant.
msgid "Let MCP clients take pictures of controls on the &screen"
msgstr "Izinkan klien MCP mengambil &gambar kontrol di layar"

#. Translators: Said before an MCP client connects to a web browser's remote debugging.
#. {browser} is the browser's name, such as Brave or Google Chrome.
msgid ""
"NVDA MCP is connecting to {browser} to read this web page. {browser} will "
"ask whether to allow remote debugging."
msgstr ""
"NVDA MCP sedang tersambung ke {browser} untuk membaca halaman web ini. "
"{browser} akan menanyakan apakah remote debugging diizinkan."

#. Translators: A button in the NVDA MCP settings panel that sets up the chosen MCP client.
msgid "Set &up now"
msgstr "&Pasang sekarang"

#. Translators: Asked before NVDA MCP adds itself to an MCP client's settings file.
#. {client} is the client, such as Claude Desktop; {path} is the settings file.
msgid ""
"NVDA MCP will add itself to {client}'s settings, in {path}. Its other "
"settings stay as they are, and a copy of the current file is kept with .bak "
"added to its name. Continue?"
msgstr ""
"NVDA MCP akan menambahkan dirinya ke pengaturan {client}, di {path}. "
"Pengaturan lainnya tidak berubah, dan salinan file yang sekarang disimpan "
"dengan tambahan .bak di namanya. Lanjutkan?"

#. Translators: Asked before NVDA MCP runs an MCP client's setup command.
#. {client} is the client, such as Claude Code; {command} is the command.
msgid ""
"NVDA MCP will run this command to set up {client}:\n"
"{command}\n"
"Continue?"
msgstr ""
"NVDA MCP akan menjalankan perintah ini untuk memasang {client}:\n"
"{command}\n"
"Lanjutkan?"

#. Translators: The title of the dialog asking to set up an MCP client.
msgid "Set up {client}"
msgstr "Pasang {client}"

#. Translators: Reported while an MCP client's setup command runs.
msgid "Setting up {client}..."
msgstr "Memasang {client}..."

#. Translators: Reported after NVDA MCP set up an MCP client. {client} is the client, such as Cursor.
msgid "{client} is set up. Restart {client} so it starts NVDA MCP."
msgstr "{client} sudah terpasang. Mulai ulang {client} agar menjalankan NVDA MCP."

#. Translators: Shown when setting up an MCP client failed. {error} says why, in English.
msgid ""
"{client} could not be set up. {error}\n"
"You can copy the setup command and add it by hand."
msgstr ""
"{client} tidak dapat dipasang. {error}\n"
"Anda bisa menyalin perintah penyiapan dan menambahkannya sendiri."

#. Translators: The title of the message shown when setting up an MCP client failed.
msgid "NVDA MCP setup failed"
msgstr "Pemasangan NVDA MCP gagal"

#. Translators: Describes a command in the Input Gestures dialog.
msgid "Copies what NVDA sees here, to paste into a chat with any AI assistant"
msgstr "Menyalin apa yang dilihat NVDA di sini, untuk ditempel ke obrolan dengan asisten AI mana pun"

#. Translators: Reported after copying what NVDA sees, to paste into an AI chat.
msgid "Copied what NVDA sees here. It can include private text from this window."
msgstr "Apa yang dilihat NVDA di sini sudah disalin. Isinya bisa memuat teks pribadi dari jendela ini."

#. Translators: A text field in the NVDA MCP settings panel. MCP Access lets a helper's AI assistant
#. work with this computer's NVDA from far away, through a relay server at this address.
msgid "MCP Access &relay address:"
msgstr "Alamat &relay MCP Access:"

#. Translators: Describes a command in the Input Gestures dialog. MCP Access lets someone the user trusts
#. help them from far away, with an AI assistant that works through this computer's NVDA.
msgid "Shares this computer with a helper through MCP Access, or says who is connected"
msgstr "Membagikan komputer ini ke penolong lewat MCP Access, atau menyebutkan siapa yang tersambung"

#. Translators: Reported by the share command while a helper is connected.
msgid "{helper} is connected through MCP Access"
msgstr "{helper} tersambung lewat MCP Access"

#. Translators: Reported by the share command while a code waits for a helper.
msgid "Waiting for a helper. The code is {code}"
msgstr "Menunggu penolong. Kodenya {code}"

#. Translators: Reported while NVDA MCP connects to the MCP Access relay.
msgid "Connecting to MCP Access..."
msgstr "Menyambung ke MCP Access..."

#. Translators: Describes a command in the Input Gestures dialog.
msgid "Stops sharing this computer through MCP Access"
msgstr "Berhenti membagikan komputer ini lewat MCP Access"

#. Translators: Reported when the user stops sharing but nothing is shared.
msgid "This computer is not being shared"
msgstr "Komputer ini sedang tidak dibagikan"

#. Translators: Reported after NVDA MCP made an MCP Access code. {minutes} is a number.
msgid ""
"MCP Access code copied to the clipboard. Send it only to someone you trust: "
"whoever has it can ask to see this computer. It works for {minutes} minutes."
msgstr ""
"Kode MCP Access sudah disalin ke clipboard. Kirim hanya ke orang yang Anda "
"percaya: siapa pun yang memegangnya bisa meminta melihat komputer ini. Kode "
"berlaku {minutes} menit."

#. Translators: Reported when sharing through MCP Access stops.
msgid "MCP Access sharing stopped"
msgstr "Berbagi lewat MCP Access dihentikan"

#. Translators: Reported when sharing through MCP Access ends. {reason} says why, in English.
msgid "MCP Access sharing ended. {reason}"
msgstr "Berbagi lewat MCP Access berakhir. {reason}"

#. Translators: Title of the dialog asking whether to let a helper connect through MCP Access.
#. {helper} is the name the helper's program gives itself; NVDA cannot verify it.
msgid "NVDA MCP: let {helper} see this computer?"
msgstr "NVDA MCP: izinkan {helper} melihat komputer ini?"

#. Translators: Asks whether to let a helper connect through MCP Access.
#. {helper} is the name the helper's program gives itself; {check} is a short code both sides see.
msgid ""
"Someone with your MCP Access code, calling themselves {helper}, wants to see "
"this computer through NVDA, with an AI assistant: what is on the screen, what "
"NVDA says, and the text of windows. If they want to press keys or take "
"pictures of the screen, NVDA asks you first.\n"
"\n"
"Allow this only if you asked this person for help. Never tell them a "
"password. Session check: {check}. You can stop sharing at any time.\n"
"\n"
"Allow {helper} to connect?"
msgstr ""
"Seseorang yang memegang kode MCP Access Anda, yang menyebut dirinya {helper}, "
"ingin melihat komputer ini lewat NVDA, dengan asisten AI: apa yang ada di "
"layar, apa yang diucapkan NVDA, dan teks jendela. Kalau mereka ingin menekan "
"tombol atau mengambil gambar layar, NVDA bertanya kepada Anda dulu.\n"
"\n"
"Izinkan hanya kalau Anda memang meminta bantuan orang ini. Jangan pernah "
"memberi tahu kata sandi. Kode sesi: {check}. Anda bisa berhenti berbagi "
"kapan saja.\n"
"\n"
"Izinkan {helper} tersambung?"

#. Translators: Reported when the helper ends an MCP Access session. {helper} is their name.
msgid "{helper} ended the MCP Access session"
msgstr "{helper} mengakhiri sesi MCP Access"

#. Translators: Reported after the user answered No to a helper connecting through MCP Access.
msgid "MCP Access: the helper was not allowed to connect"
msgstr "MCP Access: penolong tidak diizinkan tersambung"

#. Translators: Reported when nobody used an MCP Access code in time.
msgid "The MCP Access code expired before anyone used it. Share again for a new code."
msgstr "Kode MCP Access kedaluwarsa sebelum dipakai. Bagikan lagi untuk mendapat kode baru."

#. Translators: Reported when an MCP Access session reaches its time limit.
msgid "MCP Access sharing ended after two hours. Share again if you still need help."
msgstr "Berbagi lewat MCP Access berakhir setelah dua jam. Bagikan lagi kalau masih butuh bantuan."

#. Translators: Reported when MCP Access stops because a message could not be verified.
msgid "MCP Access stopped because the connection was not secure"
msgstr "MCP Access dihentikan karena sambungannya tidak aman"

#. Translators: Reported when the connection to the MCP Access relay is lost.
msgid "MCP Access sharing ended: the connection to the relay was lost"
msgstr "Berbagi lewat MCP Access berakhir: sambungan ke relay terputus"

#. Translators: A checkbox in the NVDA MCP settings panel. Without it, a helper connected through
#. MCP Access may ask to press keys, and NVDA asks the user once per session.
msgid "&Never let MCP Access helpers press keys"
msgstr "&Jangan pernah izinkan penolong MCP Access menekan tombol"

#. Translators: Asks the person being helped whether their MCP Access helper may press keys.
#. {who} is who is asking, such as "An MCP client calling itself Rafli through MCP Access".
msgid ""
"{who} wants to press keys on this computer through NVDA, for example to move "
"through an application with Tab. You hear every key through NVDA, and you can "
"stop sharing at any time. Keys go to whichever window is active.\n"
"\n"
"Allow this for this MCP Access session only?"
msgstr ""
"{who} ingin menekan tombol di komputer ini lewat NVDA, misalnya untuk "
"berpindah di dalam aplikasi dengan Tab. Anda mendengar setiap tombol lewat "
"NVDA, dan bisa berhenti berbagi kapan saja. Tombol masuk ke jendela mana pun "
"yang sedang aktif.\n"
"\n"
"Izinkan untuk sesi MCP Access ini saja?"

#. Translators: A checkbox in the NVDA MCP settings panel. Without it, a helper connected through
#. MCP Access may ask to take pictures of the screen, and NVDA asks the user once per session.
msgid "Never let MCP Access helpers take p&ictures of the screen"
msgstr "Jangan pernah izinkan penolong MCP Access mengambil gambar &layar"

#. Translators: Title of the dialog asking whether an MCP Access helper may take pictures of the screen.
#. {client} is the name the helper gives itself, such as "Rafli through MCP Access".
msgid "NVDA MCP: allow {client} to take pictures of the screen?"
msgstr "NVDA MCP: izinkan {client} mengambil gambar layar?"

#. Translators: Asks the person being helped whether their MCP Access helper may take pictures.
#. {client} is the name the helper gives itself, such as "Rafli through MCP Access".
msgid ""
"{client} wants to take pictures of parts of this computer's screen, to see "
"what a control looks like. Each picture shows whatever is on the screen there "
"and is sent to their AI assistant. Every picture is written to the action "
"log.\n"
"\n"
"Allow this for this MCP Access session only?"
msgstr ""
"{client} ingin mengambil gambar bagian layar komputer ini, untuk melihat "
"tampilan sebuah kontrol. Setiap gambar memperlihatkan apa pun yang ada di "
"layar di sana dan dikirim ke asisten AI mereka. Setiap gambar dicatat di "
"catatan aksi.\n"
"\n"
"Izinkan untuk sesi MCP Access ini saja?"

#. Translators: Reported when a message to the MCP Access helper could not be sent.
msgid "The message could not be sent: {error}"
msgstr "Pesan tidak dapat dikirim: {error}"

#. Translators: Reported after a message to the MCP Access helper was sent.
msgid "Message sent"
msgstr "Pesan terkirim"

#. Translators: A message from the MCP Access helper. {helper} is their name; {text} what they wrote.
msgid "Message from {helper}: {text}"
msgstr "Pesan dari {helper}: {text}"

#. Translators: The title of the MCP Access window, where the user talks with their helper.
msgid "NVDA MCP Access"
msgstr "NVDA MCP Access"

#. Translators: The label of the list of messages in the MCP Access window.
msgid "&Messages:"
msgstr "&Pesan:"

#. Translators: The label of the field for a message to the helper in the MCP Access window.
msgid "&Your message (Enter sends):"
msgstr "Pesan &Anda (Enter untuk mengirim):"

#. Translators: A button in the MCP Access window that sends the message to the helper.
msgid "&Send"
msgstr "&Kirim"

#. Translators: A button in the MCP Access window that ends sharing this computer.
msgid "S&top sharing"
msgstr "&Berhenti berbagi"

#. Translators: A button that closes the MCP Access window; sharing goes on.
msgid "&Close"
msgstr "&Tutup"

#. Translators: Status in the MCP Access window after sharing ended.
msgid "Sharing has ended. Share again for a new code."
msgstr "Berbagi sudah berakhir. Bagikan lagi untuk mendapat kode baru."

#. Translators: Status in the MCP Access window. {helper} is their name; {check} the session check.
msgid "Connected with {helper}. Session check: {check}."
msgstr "Tersambung dengan {helper}. Kode sesi: {check}."

#. Translators: Status in the MCP Access window while the code waits for a helper.
msgid "Waiting for a helper. Code: {code}"
msgstr "Menunggu penolong. Kode: {code}"

#. Translators: A message from the helper in the MCP Access window. {helper} is their name.
msgid "{helper}: {text}"
msgstr "{helper}: {text}"

#. Translators: A message the user sent, in the MCP Access window.
msgid "You: {text}"
msgstr "Anda: {text}"

#. Translators: Describes a command in the Input Gestures dialog. The MCP Access window shows the
#. conversation with the helper, a field to answer them, and a button to stop sharing.
msgid "Opens the MCP Access window, to talk with your helper"
msgstr "Membuka jendela MCP Access, untuk mengobrol dengan penolong"

#. Translators: Reported when the user opens the MCP Access window before sharing.
msgid "This computer is not being shared. Use the share command first."
msgstr "Komputer ini sedang tidak dibagikan. Pakai perintah berbagi dulu."

#. Translators: Reported when a helper connects through MCP Access.
msgid "{helper} is connected through MCP Access. The MCP Access window has your conversation."
msgstr "{helper} tersambung lewat MCP Access. Percakapan Anda ada di jendela MCP Access."
